# Apache 2.4: serve prerendered routes and real 404s (requires mod_rewrite).
Options -Indexes -MultiViews
DirectoryIndex index.html
DirectorySlash Off
ErrorDocument 404 /404.html
RewriteEngine On

# Redirect only the production hosts; local previews remain local.
RewriteCond %{HTTP_HOST} ^(?:www\.)?sayri\.pe$ [NC]
RewriteCond %{HTTP_HOST} !^www\.sayri\.pe$ [NC,OR]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://www.sayri.pe%{REQUEST_URI} [R=301,L,NE]

# Canonical paths have no trailing slash, except the home page.
RewriteCond %{THE_REQUEST} \s/+(.+?)/+[?\s]
RewriteRule ^(.+)/$ /$1 [R=301,L,NE]

RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [END]
# No SPA catch-all: unknown URLs must return HTTP 404.
